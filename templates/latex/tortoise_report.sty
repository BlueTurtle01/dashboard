%% ── Status badge ──────────────────────────────────────────────────────────────
%% Safe inside table cells. Uses xstring for matching.
\RequirePackage{xstring}

\newcommand{\StatusBadge}[1]{%
  \IfEqCase*{#1}{%
    {Strong}{\colorbox{TortoiseGreen}{\color{white}\footnotesize\bfseries~Strong~}}%
    {Covered}{\colorbox{TortoiseGreen}{\color{white}\footnotesize\bfseries~Covered~}}%
    {Moderate}{\colorbox{TortoiseAmber}{\color{white}\footnotesize\bfseries~Moderate~}}%
    {Partial}{\colorbox{TortoiseAmber}{\color{white}\footnotesize\bfseries~Partial~}}%
    {Major gap}{\colorbox{TortoiseRed}{\color{white}\footnotesize\bfseries~Major gap~}}%
    {None}{\colorbox{TortoiseRed}{\color{white}\footnotesize\bfseries~None~}}%
    {Surface gap}{\colorbox{TortoiseAmber}{\color{white}\footnotesize\bfseries~Surface gap~}}%
    {Unknown}{\colorbox{TortoiseGrey}{\color{TortoiseDarkGrey}\footnotesize\bfseries~Unknown~}}%
  }[\colorbox{TortoiseGrey}{\color{TortoiseDarkGrey}\footnotesize\bfseries~#1~}]%
}

%% Priority badge (for Next Steps section)
\newcommand{\PriorityBadge}[1]{%
  \IfEqCase*{#1}{%
    {Priority}{\colorbox{TortoiseRed}{\color{white}\footnotesize\bfseries~Priority~}}%
    {Recommended}{\colorbox{TortoiseAmber}{\color{white}\footnotesize\bfseries~Recommended~}}%
    {Optional}{\colorbox{TortoiseMidGrey}{\color{TortoiseDarkGrey}\footnotesize\bfseries~Optional~}}%
  }[\colorbox{TortoiseGrey}{\color{TortoiseDarkGrey}\footnotesize\bfseries~#1~}]%
}

%% ── Progress bar ──────────────────────────────────────────────────────────────
%% \ProgressBar[color]{ratio}  — ratio in [0,1], full width = 6cm
\newcommand{\ProgressBar}[2][TortoiseGreen]{%
  \begin{tikzpicture}[baseline=-0.5ex]
    \fill[TortoiseMidGrey!40] (0,0) rectangle (6cm,0.22cm);
    \pgfmathsetmacro{\barwidth}{min(6, #2 * 6)}%
    \fill[#1] (0,0) rectangle (\barwidth cm, 0.22cm);
  \end{tikzpicture}%
}

%% \LabelledProgressBar{label}{value text}{ratio}
\newcommand{\LabelledProgressBar}[3]{%
  \noindent
  \begin{minipage}[t]{0.30\linewidth}
    \small\RaggedRight #1
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{0.40\linewidth}
    \centering\ProgressBar{#3}
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{0.22\linewidth}
    \small\RaggedLeft #2
  \end{minipage}%
  \vspace{3pt}
}

%% ── tabularray branded long table ─────────────────────────────────────────────
\RequirePackage{tabularray}
\UseTblrLibrary{booktabs}

\NewTblrEnviron{TortoiseLongTable}
\SetTblrInner[TortoiseLongTable]{
  hline{1,2}={TortoiseGreen,1.5pt},
  hline{Z}={TortoiseGreen,1.5pt},
  hline{3-Y}={TortoiseMidGrey,0.3pt},
  row{odd}={bg=TortoiseGrey},
  row{even}={bg=TortoiseWhite},
  row{1}={bg=TortoiseGreen, fg=TortoiseWhite, font=\bfseries\small},
  rowhead=1,
  width=\linewidth,
  cells={font=\small, valign=m, rowsep=3pt, colsep=5pt},
}

%% Short compact booktabs table (non-breaking, centred)
%% Use directly in document with \begin{booktabs-like} commands
%% No environment needed here — generators use standard tabular/booktabs.

%% ── Ragged2e ──────────────────────────────────────────────────────────────────
\RequirePackage{ragged2e}

%% ── enumitem ──────────────────────────────────────────────────────────────────
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.2em, itemsep=2pt, topsep=4pt}
