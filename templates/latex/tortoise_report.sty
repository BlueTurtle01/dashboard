%% tortoise_report.sty
%% Tortoise Endurance — Race Readiness Report brand style
%% Compatible with pdflatex. Load AFTER geometry, fontenc, inputenc.
%%
%% Required packages (load in .tex document):
%%   xcolor, tcolorbox (with skins + breakable), tabularray (with booktabs),
%%   fancyhdr, titlesec, pgfplots, tikz, booktabs, longtable, array,
%%   microtype, enumitem, ragged2e, xstring, calc

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tortoise_report}[2024/01/01 Tortoise Endurance Report Style]

%% ── Colour palette ────────────────────────────────────────────────────────────
\definecolor{TortoiseGreen}{HTML}{1F4D3A}
\definecolor{TortoiseLightGreen}{HTML}{EAF4EF}
\definecolor{TortoiseRed}{HTML}{B23A3A}
\definecolor{TortoiseLightRed}{HTML}{F8EAEA}
\definecolor{TortoiseAmber}{HTML}{C97916}
\definecolor{TortoiseLightAmber}{HTML}{FFF4E0}
\definecolor{TortoiseBlue}{HTML}{2F6FA3}
\definecolor{TortoiseLightBlue}{HTML}{EAF1F8}
\definecolor{TortoiseGrey}{HTML}{F5F6F4}
\definecolor{TortoiseTableAlt}{HTML}{EEEEEC}
\definecolor{TortoiseMidGrey}{HTML}{BBBBBB}
\definecolor{TortoiseDarkGrey}{HTML}{444444}
\definecolor{TortoiseWhite}{HTML}{FFFFFF}

%% Keep legacy colour names working (used in pgfplots + existing code)
\colorlet{darkgreen}{TortoiseGreen}
\colorlet{accentgreen}{TortoiseGreen}
\colorlet{accentred}{TortoiseRed}
\colorlet{accentorange}{TortoiseAmber}
\colorlet{accentblue}{TortoiseBlue}
\colorlet{rowred}{TortoiseLightRed}
\colorlet{roworange}{TortoiseLightAmber}
\colorlet{rowgreen}{TortoiseLightGreen}
\colorlet{rowgray}{TortoiseGrey}

%% ── Page geometry ─────────────────────────────────────────────────────────────
%% (geometry is set in the .tex preamble; we only tweak text width usage here)

%% ── Header / footer ───────────────────────────────────────────────────────────
\RequirePackage{fancyhdr}
\RequirePackage{calc}

\newcommand{\@racename}{Race Readiness Report}
\newcommand{\racenameset}[1]{\gdef\@racename{#1}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{%
  \small\textsc{\color{TortoiseGreen}Tortoise Endurance}%
}
\fancyhead[R]{%
  \small\color{TortoiseDarkGrey}\@racename%
}
\fancyfoot[C]{%
  \small\color{TortoiseDarkGrey}\thepage%
}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{%
  {\color{TortoiseGreen}\hrule height 0.6pt width\headwidth}%
}
\renewcommand{\footrulewidth}{0pt}
\setlength{\headheight}{14pt}

%% Plain style for title + TOC pages
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\small\color{TortoiseDarkGrey}\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

%% ── Section / subsection formatting ──────────────────────────────────────────
\RequirePackage{titlesec}

\titleformat{\section}
  {\large\bfseries\color{TortoiseGreen}}
  {}{0em}{}
  [\vspace{2pt}\textcolor{TortoiseGreen}{\titlerule[1.5pt]}\vspace{4pt}]

\titleformat{\subsection}
  {\normalsize\bfseries\color{TortoiseDarkGrey}}
  {}{0em}{}
  [\vspace{1pt}\textcolor{TortoiseMidGrey}{\titlerule[0.5pt]}\vspace{2pt}]

\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

%% ── tcolorbox environments ────────────────────────────────────────────────────
\RequirePackage[skins,breakable]{tcolorbox}

%% Neutral metric card (grey)
\newtcolorbox{MetricCardBox}[1]{
  enhanced, breakable,
  colback=TortoiseGrey, colframe=TortoiseMidGrey,
  coltitle=TortoiseGreen, fonttitle=\bfseries\small,
  title=\textsc{#1},
  boxrule=0.5pt, arc=3pt,
  left=6pt, right=6pt, top=4pt, bottom=4pt,
  before skip=4pt, after skip=4pt
}
%% Green / positive variant
\newtcolorbox{MetricCardGreen}[1]{
  enhanced, breakable,
  colback=TortoiseLightGreen, colframe=TortoiseGreen,
  coltitle=TortoiseGreen, fonttitle=\bfseries\small,
  title=\textsc{#1},
  boxrule=0.8pt, arc=3pt,
  left=6pt, right=6pt, top=4pt, bottom=4pt,
  before skip=4pt, after skip=4pt
}
